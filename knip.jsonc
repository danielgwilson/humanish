{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/index.ts",
        // Packaged into the guest runtime and started there by path.
        "src/guest-media-worker.ts",
        "scripts/**/*.{mjs,ts}",
        "runtime/**/*.mjs",
        // Served to the browser by bench and fixture labs.
        "bench/*/app.js",
        "fixtures/**/*.{mjs,js}",
        "docs/architecture/examples/**/*.mjs",
        "tests/fixtures/**/*.mjs",
      ],
      "project": ["src/**/*.ts", "scripts/**/*.{mjs,ts}", "tests/**/*.ts"],
      // scripts/observer-reliability-proof.mjs loads it with require.resolve.
      "ignoreDependencies": ["axe-core"],
    },
    "observer": {
      // Vendored registry output (PROVENANCE.md): its exports are the registry item's API.
      "entry": ["index.html", "lib/humanish/theme.ts", "components/terminal-cast.tsx"],
      "project": ["**/*.{ts,tsx,css}"],
      // Re-vendors registry items (observer/PROVENANCE.md).
      "ignoreDependencies": ["shadcn"],
    },
    "tui": {
      "entry": ["src/entry.tsx"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "site": {
      // Files that registry.json publishes are public API. registry/css is generated by
      // scripts/extract-registry-css.mjs.
      "entry": [
        "scripts/*.mjs",
        "registry/css/*.css",
        "components/{terminal-cast,persona-lane,cover-canvas,pinned-replay}.tsx",
        "lib/{covers,theme}.ts",
      ],
      "project": ["**/*.{ts,tsx,css,mdx}"],
    },
  },
  // scripts/guest-runtime-proof-child.mjs runs inside the guest, where these paths exist.
  "ignoreUnresolved": ["^/opt/humanish/"],
  // knip's default issue types plus cycles. `include` replaces the defaults, so all are listed.
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "optionalPeerDependencies",
    "unlisted",
    "binaries",
    "unresolved",
    "exports",
    "types",
    "enumMembers",
    "namespaceMembers",
    "duplicates",
    "catalog",
    "catalogReferences",
    "cycles",
  ],
  "cycles": {
    // Known cycles, removed by the run.ts and study-analysis splits. Any new cycle fails `pnpm knip`.
    "allow": [
      ["src/observer-data.ts", "src/run.ts"],
      ["src/analysis/store.ts", "src/analysis/job.ts"],
    ],
  },
}
