{
  "name": "humanish-site",
  "version": "0.1.0",
  "private": true,
  "description": "humanish.dev landing page (Next.js App Router).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "registry:build": "node scripts/extract-registry-css.mjs && shadcn build registry.json -o public/r",
    "registry:check": "pnpm registry:build && git add -N -- registry/css public/r && git diff --exit-code -- registry/css public/r"
  },
  "dependencies": {
    "@types/mdx": "^2.0.14",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.15.7",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "16.15.7",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
