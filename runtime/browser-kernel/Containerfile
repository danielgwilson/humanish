# Nonprivileged development builder. This image is never booted as a guest.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG DEBIAN_SNAPSHOT
ARG SECURITY_SNAPSHOT
ENV DEBIAN_FRONTEND=noninteractive LC_ALL=C.UTF-8 TZ=UTC
COPY packages.list /tmp/packages.list
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/* /etc/apt/apt.conf.d/docker-clean \
 && printf 'Types: deb deb-src\nURIs: http://snapshot.debian.org/archive/debian/%s/\nSuites: trixie trixie-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\nCheck-Valid-Until: no\n\nTypes: deb deb-src\nURIs: http://snapshot.debian.org/archive/debian-security/%s/\nSuites: trixie-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\nCheck-Valid-Until: no\n' "$DEBIAN_SNAPSHOT" "$SECURITY_SNAPSHOT" > /etc/apt/sources.list.d/kernel-build.sources \
 && printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d && chmod 0755 /usr/sbin/policy-rc.d \
 && apt-get update \
 && apt-get dist-upgrade -y --no-install-recommends \
 && xargs -a /tmp/packages.list apt-get install -y --no-install-recommends \
 && mkdir -p /provenance \
 && dpkg-query -W -f='${binary:Package}\t${Version}\t${source:Package}\t${source:Version}\n' > /provenance/packages.tsv \
 && dpkg-query -W -f='${binary:Package}=${Version}\n' > /provenance/package-versions.txt \
 && xargs -a /provenance/package-versions.txt apt-get install -y --reinstall --download-only --no-install-recommends \
 && cp -a /var/cache/apt/archives /provenance/debs \
 && cp -a /usr/share/doc /provenance/notices \
 && gcc --version > /provenance/gcc.txt \
 && ld --version > /provenance/binutils.txt
WORKDIR /work
CMD ["/usr/bin/true"]
