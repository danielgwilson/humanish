          "execution": {
            "target": "e2b-desktop"
          },
          "subject": {
            "clone": {
              "depth": 1
            },
            "repos": [
              "drawdb-io/drawdb"
            ]
          }
        },
        "dryRun": true,
        "analysis": {
          "config": {
            "model": "gpt-6-astra",
            "maxCostUsd": 3,
            "timeoutMs": 600000,
            "maxOutputTokens": 16384,
            "question": null
          },
          "trigger": "default",
          "preferLargerOutput": true
        },
        "requirements": [],
        "route": "computer-use",
        "actor": "openai-computer-use",
        "runner": {
          "desktop": "e2b-desktop",
          "brain": {
            "kind": "openai",
            "model": "gpt-5.6-sol"
          },
          "participants": [
            {
              "id": "lane-01",
              "index": 0,
              "personaId": "synthetic-new-user",
              "assignment": {
                "mission": "You have never seen this diagram tool before. Add two tables and give them meaningful names, then stop and say what you did, what confused you, and where you hesitated."
              },
              "labels": {},
              "device": {
                "name": "desktop",
                "preset": {
                  "width": 1440,
                  "height": 950,
                  "isMobile": false,
                  "deviceScaleFactor": 1
                },
                "resolution": [
                  1440,
                  950
                ]
              },
              "limits": {
                "maxOutputTokens": 8192
              }
            }
          ],
          "subject": {
            "kind": "clone",
            "repo": "drawdb-io/drawdb",
            "serve": {
              "start": "npx vite preview --host 127.0.0.1 --port 3000",
              "url": "http://127.0.0.1:3000/",
              "install": "npm install --no-audit --no-fund",
              "build": "npm run build"
            },
            "env": []
          }
        },
        "concurrency": 1,
        "arrivals": {
          "declared": false,
          "firstStartMs": 0,
          "lastStartMs": 0,
          "peak": 1,
          "waiting": 0,
          "longestWaitMs": 0,
          "lastEndMs": 600000,
          "sessionMs": 600000
        },
        "sessionBudgetMs": 600000,
        "sandboxMs": 3000000,
        "caps": {
          "maxUsd": 2
        }
      },
