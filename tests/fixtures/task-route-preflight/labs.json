[
  {
    "name": "shared-clone-concurrent",
    "config": {
      "schema": "humanish.study.v3",
      "id": "task-route-preflight",
      "route": "shared-world",
      "mode": "live",
      "subject": {
        "source": "clone",
        "repos": [
          "example-org/collab-app"
        ],
        "serve": {
          "install": "pnpm install",
          "start": "pnpm start --host 0.0.0.0",
          "url": "http://127.0.0.1:3000/"
        },
        "state": {
          "checkpoint": [
            {
              "name": "state",
              "command": "printf synthetic-state"
            }
          ]
        },
        "exposure": "synthetic"
      },
      "actor": {
        "type": "openai-computer-use",
        "mission": "Explore the synthetic study fixture."
      },
      "participants": [
        {
          "id": "author",
          "instruction": "Create a note."
        },
        {
          "id": "reviewer",
          "instruction": "Review the note."
        }
      ],
      "execution": {
        "target": "e2b-desktop",
        "timeoutMs": 60000,
        "concurrency": 2
      }
    },
    "supported": false,
    "route": "shared-world"
  },
