  {
    "name": "terminal",
    "config": {
      "schema": "humanish.lab.v2",
      "id": "task-route-preflight",
      "scenario": {
        "mode": "live",
        "caps": {
          "maxUsd": 1,
          "maxJobs": 1,
          "maxMinutes": 1
        }
      },
      "subject": {
        "source": "terminal-product",
        "product": {
          "name": "synthetic-widget-cli",
          "publicSurfaces": [
            "https://example.com/widget"
          ]
        }
      },
      "actors": [
        {
          "type": "codex-exec",
          "mission": "Explore the synthetic study fixture."
        }
      ],
      "execution": {
        "target": "e2b-terminal",
        "runtimeAuth": "openai-env",
        "timeoutMs": 60000,
        "terminal": {
          "transport": "exec-stream",
          "stdin": "disabled"
        }
      }
    },
    "supported": false,
    "backend": "terminal"
  },
