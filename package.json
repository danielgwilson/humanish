{
  "name": "humanish",
  "version": "0.107.0",
  "description": "Open-source-safe CLI for persona simulation, observer review, and public-safe feedback drafts.",
  "keywords": [
    "agent-harness",
    "cli",
    "persona-simulation",
    "ui-testing",
    "ux-research"
  ],
  "homepage": "https://github.com/danielgwilson/humanish#readme",
  "bugs": {
    "url": "https://github.com/danielgwilson/humanish/issues"
  },
  "license": "MIT",
  "author": "Daniel G Wilson <daniel@danielgwilson.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielgwilson/humanish.git"
  },
  "bin": {
    "humanish": "./dist/cli.js"
  },
  "files": [
    "AGENTS.md",
    "CHANGELOG.md",
    "dist",
    "docs/architecture",
    "docs/assets",
    "docs/contracts",
    "docs/decisions",
    "docs/goals/current.md",
    "docs/principles",
    "docs/product",
    "docs/ramp",
    "docs/release",
    "docs/roadmap",
    "examples",
    "skills",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "ARCHITECTURE.md",
    "CONTEXT.md",
    "TELEMETRY.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm --filter humanish-observer build && pnpm --filter humanish-tui build && node scripts/finish-build.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm knip && pnpm prose:check && pnpm vocabulary:check && pnpm typecheck && pnpm test && pnpm tui:test && pnpm build && pnpm guest-media:startup:proof && pnpm cli:startup:test && pnpm cli:preflight:test && pnpm tui:smoke",
    "cli:startup:test": "node scripts/terminal-startup-exit-proof.mjs",
    "cli:preflight:test": "node scripts/task-route-preflight-proof.mjs",
    "humanish": "tsx src/cli.ts",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "pnpm build",
    "public-surface:scan": "node scripts/public-surface-scan.mjs",
    "api:proof": "node scripts/public-api-proof.mjs",
    "release:check": "pnpm check && pnpm api:proof && pnpm public-surface:scan && pnpm skill:check && npm pack --dry-run",
    "skill:check": "DISABLE_TELEMETRY=1 pnpm exec skills add . --list",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter humanish-observer typecheck && pnpm --filter humanish-tui typecheck",
    "tui:typecheck": "pnpm --filter humanish-tui typecheck",
    "tui:smoke": "node scripts/tui-smoke.mjs",
    "tui:test": "pnpm --filter humanish-tui test",
    "release:dogfood": "node scripts/release-dogfood.mjs",
    "browser-control:proof": "node scripts/browser-control-proof.mjs",
    "docs:generate": "tsx scripts/generate-cli-docs.ts",
    "docs:check": "tsx scripts/generate-cli-docs.ts --check && tsx scripts/check-doc-paths.ts && tsx scripts/check-doc-symbols.ts && tsx scripts/check-doc-comments.ts",
    "observer:browser:proof": "node scripts/observer-browser-proof.mjs",
    "observer:iframe:proof": "node scripts/observer-iframe-proof.mjs",
    "observer:chrome:proof": "node scripts/observer-chrome-proof.mjs",
    "observer:reliability:proof": "node scripts/observer-reliability-proof.mjs",
    "tui:connections:proof": "python3 scripts/tui-connections-proof.py",
    "guest-desktop:proof": "node scripts/guest-desktop-proof.mjs",
    "guest-media:startup:proof": "node scripts/guest-media-worker-startup-proof.mjs",
    "codex:qualify": "node --import tsx scripts/codex-qualify.mjs",
    "comms:agentmail:contract": "node --import tsx scripts/agentmail-contract-check.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "node scripts/check-lint-cap.mjs --max-warnings=442",
    "knip": "knip",
    "prose:check": "node scripts/check-code-prose.mjs --max-issue-refs=0 --max-fix-tags=0 --max-caps=0 --max-lane-comments=20 --max-em-dashes=0 --max-invariant-refs=0 --max-authority=0 --max-archaeology=0 --max-seat-comments=162 --max-cua-route=28 --max-honest=72 --max-history=18 --max-series-codes=0 --max-issue-refs-tests=221 --max-fix-tags-tests=8 --max-caps-tests=1025 --max-lane-comments-tests=369 --max-em-dashes-tests=384 --max-invariant-refs-tests=11 --max-authority-tests=19 --max-archaeology-tests=19 --max-seat-comments-tests=87 --max-cua-route-tests=26 --max-honest-tests=56 --max-history-tests=12 --max-series-codes-tests=43 --max-issue-refs-scripts=5 --max-fix-tags-scripts=0 --max-caps-scripts=66 --max-lane-comments-scripts=7 --max-em-dashes-scripts=15 --max-invariant-refs-scripts=0 --max-authority-scripts=1 --max-archaeology-scripts=0 --max-seat-comments-scripts=2 --max-cua-route-scripts=0 --max-honest-scripts=3 --max-history-scripts=0 --max-series-codes-scripts=0 --max-issue-refs-tui=11 --max-fix-tags-tui=0 --max-caps-tui=154 --max-lane-comments-tui=2 --max-em-dashes-tui=96 --max-invariant-refs-tui=0 --max-authority-tui=0 --max-archaeology-tui=0 --max-seat-comments-tui=0 --max-cua-route-tui=0 --max-honest-tui=3 --max-history-tui=1 --max-series-codes-tui=0",
    "vocabulary:check": "tsx scripts/check-retired-words.ts --max-lane=98 --max-seat=0 --max-role=49 --max-sim=21 --max-study=9 --max-doc-backend=17"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "parse5": "^8.0.1",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "undici": "^8.11.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@e2b/desktop": "^2.4.0",
    "@types/node": "catalog:",
    "@types/pngjs": "^6.0.5",
    "axe-core": "4.13.0",
    "knip": "6.38.0",
    "oxc-parser": "catalog:",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "skills": "1.7.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@e2b/desktop": "^2.3.2"
  },
  "peerDependenciesMeta": {
    "@e2b/desktop": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.8.1"
}
