{
  "name": "humanish",
  "version": "0.105.0",
  "description": "Open-source-safe CLI for persona simulation, observer review, and public-safe feedback drafts.",
  "keywords": [
    "agent-harness",
    "cli",
    "persona-simulation",
    "ui-testing",
    "ux-research"
  ],
  "homepage": "https://github.com/danielgwilson/humanish#readme",
  "bugs": {
    "url": "https://github.com/danielgwilson/humanish/issues"
  },
  "license": "MIT",
  "author": "Daniel G Wilson <daniel@danielgwilson.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielgwilson/humanish.git"
  },
  "bin": {
    "humanish": "./dist/cli.js"
  },
  "files": [
    "AGENTS.md",
    "dist",
    "docs/architecture",
    "docs/assets",
    "docs/contracts",
    "docs/goals/current.md",
    "docs/principles",
    "docs/product",
    "docs/ramp",
    "docs/release",
    "docs/roadmap",
    "skills",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm --filter humanish-observer build && pnpm --filter humanish-tui build && node scripts/finish-build.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm tui:test && pnpm build && pnpm guest-media:startup:proof && pnpm cli:startup:test && pnpm cli:preflight:test && pnpm tui:smoke",
    "cli:startup:test": "node scripts/terminal-startup-exit-proof.mjs",
    "cli:preflight:test": "node scripts/task-route-preflight-proof.mjs",
    "humanish": "tsx src/cli.ts",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "pnpm build",
    "public-surface:scan": "node scripts/public-surface-scan.mjs",
    "release:check": "pnpm check && pnpm public-surface:scan && pnpm skill:check && npm pack --dry-run",
    "skill:check": "DISABLE_TELEMETRY=1 npx skills add . --list",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter humanish-observer typecheck && pnpm --filter humanish-tui typecheck",
    "humanish:doctor": "pnpm humanish -- doctor",
    "humanish:run": "pnpm humanish -- run --dry-run",
    "humanish:watch": "pnpm humanish -- watch",
    "humanish:watch:ci": "pnpm humanish -- watch --json --no-open",
    "humanish:dogfood": "pnpm humanish -- watch",
    "humanish:verify": "pnpm humanish -- verify",
    "humanish:feedback": "pnpm humanish -- feedback issue --repo danielgwilson/humanish",
    "humanish:lab:list": "pnpm humanish -- lab list",
    "humanish:lab:oss": "pnpm humanish -- lab run oss",
    "humanish:lab:oss:ci": "pnpm humanish -- lab run oss --dry-run --json --no-open",
    "humanish:lab:oss:smoke": "pnpm humanish -- lab run oss-smoke",
    "tui:typecheck": "pnpm --filter humanish-tui typecheck",
    "tui:smoke": "node scripts/tui-smoke.mjs",
    "tui:test": "pnpm --filter humanish-tui test",
    "release:dogfood": "node scripts/release-dogfood.mjs",
    "browser-control:proof": "node scripts/browser-control-proof.mjs",
    "docs:generate": "tsx scripts/generate-cli-docs.ts",
    "docs:check": "tsx scripts/generate-cli-docs.ts --check",
    "observer:browser:proof": "node scripts/observer-browser-proof.mjs",
    "observer:iframe:proof": "node scripts/observer-iframe-proof.mjs",
    "observer:chrome:proof": "node scripts/observer-chrome-proof.mjs",
    "observer:reliability:proof": "node scripts/observer-reliability-proof.mjs",
    "tui:connections:proof": "python3 scripts/tui-connections-proof.py",
    "guest-desktop:proof": "node scripts/guest-desktop-proof.mjs",
    "guest-media:startup:proof": "node scripts/guest-media-worker-startup-proof.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --max-warnings=590"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "parse5": "^8.0.1",
    "playwright-core": "^1.60.0",
    "pngjs": "^7.0.0",
    "undici": "^6.28.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "@e2b/desktop": "^2.4.0",
    "@types/node": "^20.19.41",
    "@types/pngjs": "^6.0.5",
    "axe-core": "4.13.0",
    "oxc-parser": "0.151.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "@e2b/desktop": "^2.3.2"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@e2b/desktop": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.5.2"
}
